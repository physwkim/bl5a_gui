[Unit]
Description=BL5A spec-ioc (BL5A:SPEC:*), a client of SPEC's server
PartOf=bl5a.target
After=bl5a-sim.service

[Service]
EnvironmentFile=%h/.config/bl5a/bl5a.env
EnvironmentFile=-%h/.config/bl5a/spec-ioc.env
WorkingDirectory=@BL5A@/ioc/spec
RuntimeDirectory=bl5a-spec-ioc
ExecStart=@BL5A@/deploy/ioc-run %t/bl5a-spec-ioc/shell @BL5A@/target/release/spec-ioc st.cmd
Restart=on-failure
RestartSec=5
