# BL5A settings, read by the bl5a-* user services and by deploy/bl5a-gui
# and deploy/bl5a-mcp. systemd and sh both read this file: KEY=value
# lines, a value with spaces in double quotes, no `export`, comments on
# lines of their own. After a change: systemctl --user restart bl5a.target

# SPEC's server, host:port, as `kappa -S2 <port>` was started (spec-ioc)
SPEC=localhost:6510

# The data root (bl5a-qs --data-root, bl5a-integrator --root): an existing
# absolute directory without spaces, at the same path on every host
BL5A_DATA=/data/bl5a

# The PONI the integrator starts with (bl5a-integrator --poni)
BL5A_PONI=/path/to/bl5a.poni

# The Python of the GUI and the MCP server
BL5A_PYTHON=@PYTHON@

# Channel Access, when the site's defaults do not reach spec-ioc, the
# mar345 IOC and the ring PV
#EPICS_CA_ADDR_LIST="host1 host2"
#EPICS_CA_AUTO_ADDR_LIST=NO
