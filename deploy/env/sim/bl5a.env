# BL5A settings for the simulation, read by the bl5a-* user services and
# by deploy/bl5a-gui and deploy/bl5a-mcp. systemd and sh both read this
# file: KEY=value lines, a value with spaces in double quotes, no
# `export`, comments on lines of their own. After a change:
# systemctl --user restart bl5a.target

# bl5a-sim's SPEC server (spec-ioc)
SPEC=localhost:16510

# bl5a-sim's options after --port 16510: --sample coin|film, --seed N,
# --pos MNE=USER, --config FILE (bl5a-sim --help)
BL5A_SIM_ARGS="--sample film"

# The data root (bl5a-qs --data-root, bl5a-integrator --root)
BL5A_DATA=@DATA@

# The PONI the integrator starts with (bl5a-integrator --poni)
BL5A_PONI=@BL5A@/sim/bl5a.poni

# The Python of the GUI and the MCP server
BL5A_PYTHON=@PYTHON@

# The GUI's font size in points, 12 when unset
#BL5A_FONT_PT=12

# Channel Access kept on this computer: spec-ioc serves on 25064 and
# mar345-ioc on 25066 (spec-ioc.env, mar345-ioc.env)
EPICS_CA_ADDR_LIST="127.0.0.1:25064 127.0.0.1:25066"
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_REPEATER_PORT=25065
