# mar345-ioc: its mar345dtb, the FilePath until bl5a-qs sets one per item
# (absolute, with a trailing /), and its own Channel Access and PV Access
# server ports beside spec-ioc's. Read after bl5a.env.
MARSERVER=localhost:5001
MAR_DATA=@DATA@/
EPICS_CAS_SERVER_PORT=25066
EPICS_CAS_INTF_ADDR_LIST=127.0.0.1
EPICS_CAS_BEACON_ADDR_LIST=127.0.0.1
EPICS_CAS_AUTO_BEACON_ADDR_LIST=NO
EPICS_PVAS_SERVER_PORT=25077
EPICS_PVAS_BROADCAST_PORT=25078
EPICS_PVAS_INTF_ADDR_LIST=127.0.0.1
